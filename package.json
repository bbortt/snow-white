{
  "name": "snow-white",
  "version": "1.0.0",
  "description": "An awesome pairing with, well.. do you know Snow White and the Jaeger?",
  "keywords": [
    "coverage",
    "jaeger",
    "openapi",
    "test",
    "testautomation",
    "tracing"
  ],
  "homepage": "https://github.com/bbortt/snow-white#readme",
  "bugs": {
    "url": "https://github.com/bbortt/snow-white/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bbortt/snow-white.git"
  },
  "license": "PolyForm-Small-Business-1.0.0",
  "author": {
    "name": "Timon Borter",
    "email": "timon.borter@gmx.ch"
  },
  "scripts": {
    "clean:versionsBackup": "rimraf --glob **/pom.xml.versionsBackup",
    "e2e:await-services": "run-p --print-label e2e:wait:*",
    "e2e:wait:api-gateway": "wait-on --timeout 1m http-get://localhost:80/management/info",
    "e2e:wait:otel-collector": "wait-on --timeout 1m tcp:13133",
    "lint:markdown": "markdownlint --rules markdownlint-sentences-per-line -- **/*.md",
    "prepare": "husky",
    "prettier": "prettier \"{,**/}*.{cjs,java,js,json,md,mjs,ts,xml,yaml,yml}\"",
    "prettier:check": "npm run prettier -- --list-different",
    "prettier:format": "npm run prettier -- --write",
    "skill:check": "node .github/scripts/sync-skills.mjs --check",
    "skill:sync": "node .github/scripts/sync-skills.mjs"
  },
  "devDependencies": {
    "@ariadne-thread/clew": "0.3.0",
    "@commitlint/config-conventional": "21.2.3",
    "@prettier/plugin-xml": "3.4.2",
    "commitlint": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.49.1",
    "markdownlint-sentences-per-line": "0.1.7",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.9",
    "prettier-plugin-java": "2.11.0",
    "prettier-plugin-packagejson": "3.0.2",
    "rimraf": "6.1.3",
    "wait-on": "9.5.1"
  },
  "optionalDependencies": {
    "npm-check-updates": "23.1.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "cacheDirectories": [
    "node_modules"
  ],
  "licenseUrl": "https://polyformproject.org/licenses/small-business/1.0.0/"
}

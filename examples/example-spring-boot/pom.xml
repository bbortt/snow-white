<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.bbortt.snow-white</groupId>
    <artifactId>parent</artifactId>
    <version>1.11.2-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <groupId>io.github.bbortt.snow-white.example</groupId>
  <artifactId>example-spring-boot</artifactId>
  <packaging>jar</packaging>

  <name>application</name>
  <description>Demo Application exporting OTEL Metrics.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>

    <!--
      This module is documentation that happens to compile: its tests exist to prove the documented
      behaviour (see src/apptest), not to carry product logic, so it stays outside the coverage and
      mutation gates the microservices are held to.
    -->
    <sonar.coverage.exclusions>**/*.java</sonar.coverage.exclusions>
    <sonar.tests />
    <sonar.test.inclusions />

    <!-- Application Testing -->
    <container.registry>ghcr.io</container.registry>
    <docker.network>bridge</docker.network>
    <image.tag>${project.version}</image.tag>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.opentelemetry.javaagent</groupId>
      <artifactId>opentelemetry-javaagent</artifactId>
      <version>2.31.1</version>
      <scope>compile</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.github.bbortt.snow-white.toolkit</groupId>
      <artifactId>spring-web-autoconfiguration</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      springdoc 1.x targets Spring Boot 2 and silently contributes nothing to a Boot 4 context -
      `/v3/api-docs` and `/swagger-ui.html` both answered 404. The 3.x line is the one built
      against Boot 4 (its parent is `spring-boot-starter-parent` 4.1.0), and the artifact was
      renamed along the way.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc-openapi.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
          <!--
            Spring MVC resolves `@RequestParam`/`@PathVariable` names from the compiled
            parameter names when the annotation does not state one - without this every
            request to `/ping` and `/pung/{message}` fails with
            "parameter name information not available via reflection".
          -->
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-otel-agent</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeGroupIds>io.opentelemetry.javaagent</includeGroupIds>
              <includeArtifactIds>opentelemetry-javaagent</includeArtifactIds>
              <outputDirectory>
                ${project.build.directory}/opentelemetry-javaagent
              </outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Coverage and mutation gates stay off for this module (see sonar.coverage.exclusions above):
        it is an example application for others to explore how Snow-White works, and its tests
        assert the documented behaviour rather than aiming at a coverage figure.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <configuration>
              <classifier>executable</classifier>
              <mainClass>
                io.github.bbortt.snow.white.example.application.Application
              </mainClass>
            </configuration>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>apptest</id>

      <dependencies>
        <dependency>
          <groupId>org.awaitility</groupId>
          <artifactId>awaitility</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.citrusframework</groupId>
          <artifactId>citrus-http</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.citrusframework</groupId>
          <artifactId>citrus-junit-jupiter</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.wiremock</groupId>
          <artifactId>wiremock</artifactId>
          <version>${org.wiremock.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>

      <build>
        <testResources>
          <testResource>
            <directory>src/apptest/resources</directory>
          </testResource>
        </testResources>

        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>add-test-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/apptest/java</source>
                    <!--
                      The clew traceable constants the app tests anchor on, compiled straight from
                      the generated sources rather than pulled in through `commons` (which is how
                      internal/commons gets them, see its add-clew-traceables-source execution):
                      the whole point of ARCH-013 is that adopting the convention costs a service no
                      Snow-White dependency at all (STK-003), and this module is the demonstration
                      of that.
                    -->
                    <source>${project.basedir}/../../src/main/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skip>true</skip>
            </configuration>
          </plugin>

          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>
                    ${container.registry}/bbortt/snow-white/example-spring-boot:${image.tag}
                  </name>
                  <alias>example-spring-boot</alias>
                  <run>
                    <env>
                      <!--
                        Only the export destination is test-specific. The baggage-to-attribute copy
                        under test is configured in the Dockerfile, so the test proves what the
                        published image does - not what this profile sets up for it.
                      -->
                      <OTEL_EXPORTER_OTLP_PROTOCOL>
                        http/protobuf
                      </OTEL_EXPORTER_OTLP_PROTOCOL>
                      <OTEL_EXPORTER_OTLP_ENDPOINT>
                        http://otel-collector:4318
                      </OTEL_EXPORTER_OTLP_ENDPOINT>
                      <OTEL_METRICS_EXPORTER>none</OTEL_METRICS_EXPORTER>
                      <OTEL_LOGS_EXPORTER>none</OTEL_LOGS_EXPORTER>
                      <!--
                        The default batch delay is 5s; a shorter one only makes the assertion arrive
                        sooner, it has no bearing on which attributes a span carries.
                      -->
                      <OTEL_BSP_SCHEDULE_DELAY>1000</OTEL_BSP_SCHEDULE_DELAY>
                    </env>
                    <log>
                      <prefix>example-spring-boot</prefix>
                      <date>default</date>
                    </log>
                    <network>
                      <name>${docker.network}</name>
                    </network>
                    <ports>
                      <port>18080:8080</port>
                    </ports>
                    <wait>
                      <!--
                        The example ships no management endpoint, so its own /ping is the readiness
                        signal - which also means the container is only declared started once it
                        answers a request, i.e. once the agent is attached and exporting.
                      -->
                      <http>
                        <url>http://localhost:18080/ping?message=readiness</url>
                        <method>GET</method>
                        <status>200</status>
                      </http>
                      <time>60000</time>
                    </wait>
                  </run>
                </image>
              </images>
            </configuration>

            <executions>
              <execution>
                <id>start-containers</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>start</goal>
                </goals>
              </execution>

              <execution>
                <id>stop-containers</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <configuration>
                  <includes>
                    <include>**/*AppTest.java</include>
                  </includes>
                </configuration>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
